#
# ssh3-rust-server: systemd EnvironmentFile (instance configuration).
# Every variable has a command line counterpart; the command line wins.

# Authentication: public keys by default (~/.ssh3/authorized_identities or
# ~/.ssh/authorized_keys of the target user). Password login is off by
# default; set this to 1 to turn it on. The root account never authenticates
# by password.
# SSH3_ENABLE_PASSWORD_LOGIN=1

# The secret URL path the server accepts its CONNECT requests on.
# SSH3_URL_PATH=/ssh3-term

# The forwarding targets the clients may reach through the server (the
# PermitOpen analog of the sshd canon): a comma/space separated list of
# host:port entries, "*" wildcards the host and "!" negates an entry. An
# empty value keeps the forwarding unrestricted.
# SSH3_PERMIT_OPEN=*.example.org:443,!10.0.0.0:*

# The addresses the reverse-forward listeners may bind (the PermitListen
# analog).
# SSH3_PERMIT_LISTEN=127.0.0.1:*

# The DoS guards of the authentication phase: the cap of the conversations
# that wait for their authentication, the failed password attempts that lock
# an account out and how long the lockout lasts.
# SSH3_MAX_UNAUTH_CONVERSATIONS=100
# SSH3_MAX_PASSWORD_FAILURES=10
# SSH3_PASSWORD_LOCKOUT_SECONDS=60

# The GatewayPorts policy of the reverse (-R) forwards, the sshd_config
# semantics: no (the default) forces every bind back to the loopback,
# clientspecified honors the requested address, yes binds the wildcard.
# SSH3_GATEWAY_PORTS=no

# The caps of the forwarding machinery: the reverse listeners one user may
# hold, the concurrent QUIC connections (0 = no limit), the channels one
# conversation may keep open (0 = no limit) and the peer-initiated QUIC
# streams per connection.
# SSH3_MAX_REVERSE_FORWARDS=10
# SSH3_MAX_CONNECTIONS=0
# SSH3_MAX_CHANNELS_PER_CONVERSATION=64
# SSH3_MAX_INCOMING_STREAMS=100
# SSH3_MAX_INCOMING_UNI_STREAMS=100

# The sftp path isolation: chroot (the default, the sshd model: a
# per-session child chroots into the user's home and drops to its uid/gid)
# or lexical (the in-process jail). The chroot needs a unix platform.
# SSH3_SFTP_JAIL=chroot

# The cap of the concurrent sftp sessions one user may hold (0 = no limit).
# SSH3_MAX_SFTP_SESSIONS_PER_USER=16

# The QUIC timeouts of the server: the handshake timeout and the idle
# timeout of an established connection. The values are durations ("120s",
# "2m", "24h"); a bare number is read as seconds.
# SSH3_HANDSHAKE_IDLE_TIMEOUT=120s
# SSH3_MAX_IDLE_TIMEOUT=24h

# Graceful shutdown: seconds to wait for the connections being served after
# SIGTERM before closing them (default 5, 0 = close immediately). A plain
# number, like the Go reference parses it.
# SSH3_SHUTDOWN_DRAIN=5

# The log of the daemon: the level names of the reference are trace, debug,
# info, warning and error, case-insensitive, and an unknown name keeps the
# warn default. The file is opened in the append mode; an empty or unset
# value writes to the standard error, which under systemd reaches the
# journal, and outside systemd falls back to /var/log/ssh3.log like the Go
# reference does.
# SSH3_LOG_LEVEL=info
# SSH3_LOG_FILE=

# locale forwarded by the server to user shells
LANG=C.UTF-8
