Shim patch for the crates.io h3 0.0.8 crate.

The workspace pins h3 through a [patch.crates-io] path override to
vendor/h3. The vendored tree is the upstream crates.io h3 0.0.8 release
with three local edits applied:

  * src/ext.rs            - the closed 'Protocol' enumeration is replaced by
                            an open 'Cow<str>' token, so that the SSH3 extended
                            CONNECT ':protocol' value ('ssh3') can be carried
                            on the wire. Upstream h3 only knows 'webtransport'
                            and 'connect-udp'.
  * src/proto/headers.rs  - 'ext.get::<Protocol>().copied()' becomes
                            '.cloned()', because the open Protocol token is no
                            longer Copy.
  * src/client/connection.rs - the client driver no longer refuses a
                            server-initiated bidirectional stream with the
                            H3_STREAM_CREATION_ERROR connection error of
                            RFC 9114, section 6.1. The SSH3 protocol carries
                            its own channels on those streams (the reverse
                            forwarding bridges the server opens towards the
                            client), and the SSH3 layer accepts them on the
                            raw QUIC connection, exactly like the reference
                            implementation does: the HTTP/3 layer must not
                            consume them, and it must not kill the connection
                            because of them.

The base stays on 0.0.8 on purpose:

  * 0.0.8 is the newest h3 release on crates.io, and the newest h3-quinn
    release (0.0.10) depends on exactly that version of h3. A newer h3
    would come with a newer h3-quinn that is not published either.
  * The unreleased h3 master still has a closed 'Protocol' enumeration (it
    knows 'webtransport', 'connect-udp', 'connect-ip' and 'websocket'), so
    the shim cannot be dropped: an arbitrary ':protocol' value such as
    'ssh3' is still refused by the upstream request encoder.
  * h3 0.0.8 already implements the final HTTP/3 (RFC 9114): the setting
    identifiers, the ALPN and the QPACK static table are the ones of the
    current quic-go. The shim was never the reason why the interop against
    quic-go v0.49.0 and later failed; the blocker was the HTTP/3 datagram
    setting, which is an application level decision (see ssh3-h3).

Apply with: patch -p1 -d <h3-0.0.8 source tree> < h3-0.0.8.patch
Verify with: scripts/verify-h3-shim.sh

diff -ruN --strip-trailing-cr h3-0.0.8/src/client/connection.rs h3-patched/src/client/connection.rs
--- a/src/client/connection.rs	2026-10-22 21:15:04.185866928 +0200
+++ b/src/client/connection.rs	2026-10-22 21:15:04.165058845 +0200
@@ -472,15 +472,13 @@
         //# receipt of a server-initiated bidirectional stream as a connection
         //# error of type H3_STREAM_CREATION_ERROR unless such an extension has
         //# been negotiated.
-        if self.inner.poll_accept_bi(cx).is_ready() {
-            return Poll::Ready(
-                self.inner
-                    .handle_connection_error(InternalConnectionError::new(
-                        Code::H3_STREAM_CREATION_ERROR,
-                        "client received a server-initiated bidirectional stream".to_string(),
-                    )),
-            );
-        }
+        //
+        // SSH3 negotiates no such extension: the protocol carries its own
+        // channels on the server-initiated bidirectional streams (the reverse
+        // forwarding bridges the server opens towards the client). The HTTP/3
+        // layer must leave those streams to the SSH3 layer, which accepts
+        // them on the raw QUIC connection: accepting the stream here would
+        // consume it, and refusing it would kill the connection.
 
         Poll::Pending
     }
diff -ruN --strip-trailing-cr h3-0.0.8/src/ext.rs h3-patched/src/ext.rs
--- a/src/ext.rs	2026-10-22 21:15:04.184454465 +0200
+++ b/src/ext.rs	2026-10-22 21:15:04.163123443 +0200
@@ -1,46 +1,39 @@
 //! Extensions for the HTTP/3 protocol.
 
-use std::str::FromStr;
+use std::{borrow::Cow, convert::Infallible, str::FromStr};
 
 /// Describes the `:protocol` pseudo-header for extended connect
 ///
 /// See: <https://www.rfc-editor.org/rfc/rfc8441#section-4>
-#[derive(Copy, PartialEq, Debug, Clone)]
-pub struct Protocol(ProtocolInner);
+#[derive(Clone, Eq, PartialEq, Hash, Debug)]
+pub struct Protocol(Cow<'static, str>);
 
 impl Protocol {
     /// WebTransport protocol
-    pub const WEB_TRANSPORT: Protocol = Protocol(ProtocolInner::WebTransport);
+    pub const WEB_TRANSPORT: Protocol = Protocol(Cow::Borrowed("webtransport"));
     /// RFC 9298 protocol
-    pub const CONNECT_UDP: Protocol = Protocol(ProtocolInner::ConnectUdp);
+    pub const CONNECT_UDP: Protocol = Protocol(Cow::Borrowed("connect-udp"));
+
+    /// Create a protocol token from a static or owned string.
+    #[inline]
+    pub fn new(value: impl Into<Cow<'static, str>>) -> Self {
+        Self(value.into())
+    }
 
     /// Return a &str representation of the `:protocol` pseudo-header value
     #[inline]
     pub fn as_str(&self) -> &str {
-        match self.0 {
-            ProtocolInner::WebTransport => "webtransport",
-            ProtocolInner::ConnectUdp => "connect-udp",
-        }
+        self.0.as_ref()
     }
 }
 
-#[derive(Copy, PartialEq, Debug, Clone)]
-enum ProtocolInner {
-    WebTransport,
-    ConnectUdp,
-}
-
 /// Error when parsing the protocol
 pub struct InvalidProtocol;
 
 impl FromStr for Protocol {
-    type Err = InvalidProtocol;
+    type Err = Infallible;
 
     fn from_str(s: &str) -> Result<Self, Self::Err> {
-        match s {
-            "webtransport" => Ok(Self(ProtocolInner::WebTransport)),
-            "connect-udp" => Ok(Self(ProtocolInner::ConnectUdp)),
-            _ => Err(InvalidProtocol),
-        }
+        Ok(Self::new(s.to_owned()))
     }
 }
diff -ruN --strip-trailing-cr h3-0.0.8/src/proto/headers.rs h3-patched/src/proto/headers.rs
--- a/src/proto/headers.rs	2026-10-22 21:15:04.186757904 +0200
+++ b/src/proto/headers.rs	2026-10-22 21:15:04.166122808 +0200
@@ -378,7 +378,7 @@
         //
         // See: [https://www.rfc-editor.org/rfc/rfc8441#section-4]
         let protocol = if method == Method::CONNECT {
-            ext.get::<Protocol>().copied()
+            ext.get::<Protocol>().cloned()
         } else {
             None
         };
